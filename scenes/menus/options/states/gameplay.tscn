[sub_resource type="Resource" id="Resource_d0tf2"]
script = ExtResource("2_ipnsj")
option_name = "Middlescroll"
option_description = "If checked, the player's strumline will be positioned in the middle of the screen rather than to the side."
option_key = "middlescroll"
option_variant = 1
